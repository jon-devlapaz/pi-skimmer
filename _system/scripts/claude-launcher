#!/usr/bin/env python3
"""Reviewed tink-sdlc-launcher protocol 1 adapter for headless Claude Code build steps.

Promises: every launch and resume passes the step pin to Claude Code explicitly as
--model model-id --effort level, with edits plus a tool allowlist (the run's own check
commands, from the committed policy and the approved run definition) and no permission
prompts, in Claude Code's restricted mode: file tools reach only the checkout and the
report folder, never the step contracts or `_system/`, and no user or checkout settings,
MCP servers or auto memory load, so a builder's edits never add commands it may run (an
allowed check still runs whatever code the builder edited, unconfined). The child gets a
clean environment without the caller's Claude Code session variables, with non-essential
traffic off and TINK_SDLC_STEP_SESSION set. resolve makes no model request (it reads
local files and runs only `git show`, `claude --help` and `claude auth status`); resume
refuses a session whose last answer was on another model, and a run that starts on
another model is stopped; finished reads only local files and reports true only when the
newest turn ended normally on the pin.
Refuses: pins without an explicit effort, models outside the reviewed allowlist (so
aliases never resolve), a Claude Code without --restricted, a signed-out Claude Code,
managed settings or environment that name a fallback model, an uncommitted verification
policy, missing sessions, and sessions recorded in another checkout.
Claude Code cannot confirm offline that the account can use a model; a pin it rejects
fails at launch.
"""
import argparse
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
import uuid
from pathlib import Path

PROTOCOL = 'tink-sdlc-launcher'
# The Claude Code executable; TINK_SDLC_CLAUDE replaces it (tests point it at a fake).
CLAUDE_COMMAND = 'claude'
PROVIDER = 'anthropic'
# Reviewed exact model IDs. Add one only after checking it answers under its own name.
MODELS = ('claude-fable-5-1', 'claude-opus-5-5', 'claude-sonnet-5-5', 'claude-haiku-5-5')
EFFORT = ('low', 'medium', 'high', 'xhigh', 'max')
# Built-in tools the builder sees; Bash runs only the allowlisted check commands.
TOOLS = ('Read', 'Glob', 'Grep', 'Edit', 'Write', 'Bash')
# The step contract and the scaffold stay out of the builder's reach even inside its checkout.
PROTECTED = ('./runs/*/steps/**', './_system/**')
MANAGED_SETTINGS = (Path('/Library/Application Support/ClaudeCode/managed-settings.json'),
                    Path('/etc/claude-code/managed-settings.json'))
# Admission must finish inside sdlc.py's 60-second adapter timeout; TINK_SDLC_CLAUDE_ADMISSION
# may only shorten it (tests use a short window).
ADMISSION_SECONDS = 50


class Refusal(Exception):
    pass


def parse_pin(pin):
    model, sep, effort = (pin or '').rpartition(':')
    if not sep or effort not in EFFORT:
        raise Refusal('Pin must name its effort explicitly: anthropic/model-id:' + '|'.join(EFFORT))
    provider, slash, model_id = model.partition('/')
    if provider != PROVIDER or not slash:
        raise Refusal(f'Pin must be {PROVIDER}/model-id; Claude Code serves no other provider here.')
    if model_id not in MODELS:
        raise Refusal(f'{model_id} is not a reviewed exact model ID ({", ".join(MODELS)}); aliases are refused.')
    return model_id, effort


def config_dir():
    configured = os.environ.get('CLAUDE_CONFIG_DIR')
    return Path(configured).expanduser() if configured else Path.home() / '.claude'


def read_json(path, label):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        raise Refusal(f'{label} is missing at {path}.') from None
    except (OSError, ValueError) as error:
        raise Refusal(f'{label} at {path} is unreadable: {error}') from None


def claude_command():
    command = os.environ.get('TINK_SDLC_CLAUDE') or shutil.which(CLAUDE_COMMAND)
    if not command:
        raise Refusal('Claude Code executable not found.')
    return command


def check_restricted():
    """--restricted is what confines the builder; an older Claude Code without it is refused."""
    try:
        result = subprocess.run([claude_command(), '--help'], capture_output=True, text=True,
                                stdin=subprocess.DEVNULL, timeout=10, env=child_env())
    except (OSError, subprocess.TimeoutExpired) as error:
        raise Refusal(f'Cannot read Claude Code options: {error}') from None
    if '--restricted' not in result.stdout:
        raise Refusal('This Claude Code has no --restricted mode; update it before a pinned step.')


def check_auth():
    """Sign-in state only, from `claude auth status`, which reads local state and sends nothing."""
    try:
        result = subprocess.run([claude_command(), 'auth', 'status'], capture_output=True, text=True,
                                stdin=subprocess.DEVNULL, timeout=10, env=child_env())
        status = json.loads(result.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        raise Refusal(f'Cannot read Claude Code sign-in state: {error}') from None
    if not isinstance(status, dict) or status.get('loggedIn') is not True:
        raise Refusal('Claude Code is not signed in; run `claude auth login` yourself.')


def check_no_fallback():
    """A fallback model would answer off the pin without the caller asking. User and checkout
    settings are never loaded (--restricted); managed settings and the environment are."""
    named = [key for key in os.environ if 'FALLBACK' in key.upper() and key.upper().startswith(('ANTHROPIC', 'CLAUDE'))]
    for path in MANAGED_SETTINGS:
        if path.is_file():
            settings = read_json(path, 'Claude Code managed settings')
            env = settings.get('env') if isinstance(settings, dict) else None
            keys = list(settings) + (list(env) if isinstance(env, dict) else []) if isinstance(settings, dict) else []
            named += [f'{path}: {key}' for key in keys if 'fallback' in key.lower()]
    if named:
        raise Refusal('A fallback model is configured (' + '; '.join(named) + '); remove it before a pinned step.')


def child_env():
    """The caller's environment minus its Claude Code session, so the child never adopts it."""
    env = {k: v for k, v in os.environ.items() if not k.startswith('CLAUDE') or k == 'CLAUDE_CONFIG_DIR'}
    env['CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC'] = '1'
    # Auto memory lives outside the checkout and loads into later sessions, the operator's too.
    env['CLAUDE_CODE_DISABLE_AUTO_MEMORY'] = '1'
    return env


def entries(path):
    found = []
    for line in path.read_text().splitlines():
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict):
            found.append(entry)
    return found


def find_session(session_id):
    if not re.fullmatch(r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}', session_id or ''):
        return None
    projects = config_dir() / 'projects'
    found = sorted(projects.glob(f'*/{session_id}.jsonl')) if projects.is_dir() else []
    return found[0] if len(found) == 1 else None


def turns(path):
    """User and assistant entries on the active branch (newest one and its parents), oldest first."""
    tree = [e for e in entries(path) if e.get('uuid') and not e.get('isSidechain')]
    by_id = {e['uuid']: e for e in tree}
    newest = [e for e in tree if e.get('type') in ('user', 'assistant')]
    chain, node, seen = [], newest[-1] if newest else None, set()
    while node and node['uuid'] not in seen:
        seen.add(node['uuid'])
        chain.append(node)
        node = by_id.get(node.get('parentUuid'))
    return [e for e in chain[::-1] if e.get('type') in ('user', 'assistant')]


def answered_by(entry):
    """The model of a real answer; synthetic error entries are not answers."""
    message = entry.get('message') if entry.get('type') == 'assistant' else None
    if not isinstance(message, dict) or entry.get('isApiErrorMessage') or message.get('model') == '<synthetic>':
        return None
    return message.get('model')


def recorded_model(path):
    for entry in reversed(turns(path)):
        if answered_by(entry):
            return answered_by(entry)
    return None


def finished(path, model_id):
    """The newest turn on the active branch is a pinned answer that ended normally."""
    chain = turns(path)
    last = chain[-1] if chain else {}
    return answered_by(last) == model_id and last['message'].get('stop_reason') == 'end_turn'


def checkout_of(contract):
    record = read_json(Path(contract), 'Step contract')
    checkout = Path(record.get('checkout') or '')
    if not checkout.is_absolute() or checkout.resolve() != Path.cwd().resolve():
        raise Refusal('Step contract checkout does not match the adapter working directory.')
    return checkout


def retained_session(args, model_id):
    if not args.session:
        raise Refusal('Resume needs the retained session identity.')
    path = find_session(args.session)
    if path is None:
        raise Refusal(f'Retained session {args.session} is missing; it is not replaced automatically.')
    checkout = checkout_of(args.contract).resolve()
    if any(Path(e['cwd']).resolve() != checkout for e in turns(path) if e.get('cwd')):
        raise Refusal(f'Retained session {args.session} ran outside {checkout}; resume refused.')
    recorded = recorded_model(path)
    # No real answer yet (say, a usage limit hit first): admission already saw it start on the pin.
    if recorded not in (None, model_id):
        raise Refusal(f'Retained session last answered on {recorded}, not the pin {model_id}; resume refused.')
    return path


def resolve(args, operation):
    model_id, effort = parse_pin(args.model)
    if not Path(args.report).is_absolute():
        raise Refusal('Report path must be absolute.')
    checkout = checkout_of(args.contract)
    check_no_fallback()
    path = retained_session(args, model_id) if operation == 'resume' else None
    run_dir, inputs = run_files(args)
    commands = allowed_commands(checkout, run_dir)
    check_restricted()
    check_auth()
    return model_id, effort, path, inputs, commands


def run_files(args):
    run_dir = Path(args.contract).resolve().parent.parent
    metadata = read_json(run_dir / 'run.json', 'Run metadata')
    if metadata.get('profile') == 'light':
        return run_dir, [run_dir / 'brief.md']
    if metadata.get('profile') == 'full':
        return run_dir, [run_dir / '01-plan/output/intent.md', run_dir / '02-design/output/spec.md',
                         run_dir / '03-build/output/plan.md']
    raise Refusal('Run profile must be light or full.')


def committed_policy(checkout):
    """The verification policy as committed: the builder can edit the working copy, and an edit
    must never widen what a resumed builder may run."""
    path = checkout / '_system/verification.json'
    try:
        committed = subprocess.run(['git', 'show', 'HEAD:_system/verification.json'], cwd=checkout,
                                   capture_output=True, timeout=10, stdin=subprocess.DEVNULL)
        current = path.read_bytes()
    except (OSError, subprocess.TimeoutExpired) as error:
        raise Refusal(f'Cannot read the committed verification policy: {error}') from None
    if committed.returncode != 0:
        raise Refusal('The verification policy is not committed; commit it before a Claude Code step.')
    if committed.stdout != current:
        raise Refusal(f'{path} differs from the committed policy; restore or commit it before launching or resuming.')
    try:
        return json.loads(current)
    except ValueError as error:
        raise Refusal(f'The verification policy is unreadable: {error}') from None


def allowed_commands(checkout, run_dir):
    """The run's own check commands, each allowed only as written. checklist.json and
    seed-checks.json are held by the definition gate that launch and resume recheck."""
    checks = list(committed_policy(checkout).get('checks') or [])
    for name in ('checklist.json', 'seed-checks.json'):
        if (run_dir / name).is_file():
            checks += [item['check'] for item in read_json(run_dir / name, name).get('items') or []
                       if isinstance(item, dict) and isinstance(item.get('check'), dict)]
    commands = []
    for check in checks:
        argv = check.get('argv') if isinstance(check, dict) else None
        if not isinstance(argv, list) or not argv or not all(isinstance(a, str) and a for a in argv):
            raise Refusal('A check has no usable argv; fix it before launching.')
        command = shlex.join(argv)
        if re.search(r'[()\n]', command):
            raise Refusal(f'Check {command!r} has parentheses or a newline and cannot be allowlisted exactly.')
        if command not in commands:
            commands.append(command)
    return commands


def prompt(args, checkout, inputs):
    context = checkout / 'stages' / '03-build' / 'CONTEXT.md'
    named_inputs = ', '.join(str(path) for path in inputs)
    return (f'You are the build agent for this run. Implement the approved run work using '
            f'{named_inputs}; read those approved inputs, stage-3 CONTEXT.md at {context}, the '
            f'step contract at {args.contract}, and checkout instructions first. Work only in '
            f'{checkout}. Write your handoff report to exactly {args.report} (absolute path). '
            f'Never run sdlc.py step, stage or decide. Do not change the model or effort. '
            f'Shell commands other than the run\'s own checks are refused.')


def stop(process):
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except OSError:
        pass


def admission_seconds():
    try:
        configured = float(os.environ.get('TINK_SDLC_CLAUDE_ADMISSION', ADMISSION_SECONDS))
    except ValueError:
        return ADMISSION_SECONDS
    return configured if 0 < configured <= ADMISSION_SECONDS else ADMISSION_SECONDS


def started_on(log, session_id):
    """The model Claude Code's init event names for this session, once it is written."""
    for line in log.read_text(errors='replace').splitlines() if log.exists() else ():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if isinstance(event, dict) and event.get('type') == 'system' and event.get('subtype') == 'init' \
                and event.get('session_id') == session_id:
            return event.get('model') or '<unnamed>'
    return None


def admit(args, operation):
    model_id, effort, retained, inputs, commands = resolve(args, operation)  # recheck right before any request
    checkout = checkout_of(args.contract)
    if operation == 'launch':
        session_id = str(uuid.uuid4())
        target = ['--session-id', session_id]
        before = 0
    else:
        session_id = args.session
        target = ['--resume', session_id]
        before = len(entries(retained))
    allowed = [tool for tool in TOOLS if tool != 'Bash'] + [f'Bash({command})' for command in commands]
    denied = [f'{tool}({path})' for path in PROTECTED for tool in ('Edit', 'Write')]
    # --restricted confines file tools to the checkout (plus the report folder), ignores user
    # and checkout settings and keeps settings and git files out of automatic approval.
    argv = [claude_command(), '-p', *target, '--model', model_id, '--effort', effort,
            '--restricted', '--strict-mcp-config', '--add-dir', str(Path(args.report).parent),
            '--permission-mode', 'acceptEdits', '--permission-prompts', 'none',
            '--tools', ','.join(TOOLS), '--allowedTools', *allowed, '--disallowedTools', *denied,
            '--output-format', 'stream-json', '--verbose', '--', prompt(args, checkout, inputs)]
    log = Path(args.contract).with_name(f'{Path(args.contract).stem}.{operation}-{int(time.time())}.claude.log')
    env = child_env()
    env['TINK_SDLC_STEP_SESSION'] = '1'
    with log.open('ab') as output:
        process = subprocess.Popen(argv, cwd=checkout, env=env, stdin=subprocess.DEVNULL, stdout=output,
                                   stderr=output, start_new_session=True)
    window = admission_seconds()
    deadline = time.monotonic() + window
    while time.monotonic() < deadline:
        model = started_on(log, session_id)
        path = retained or find_session(session_id)
        answers = [answered_by(e) for e in entries(path)[before:]] if path else []
        drifted = [m for m in [model, *answers] if m and m != model_id]
        if drifted:
            stop(process)
            raise Refusal(f'Claude Code ran on {drifted[0]}, not the pin {model_id}; the run was stopped. Log: {log}')
        asked = any(e.get('type') == 'user' for e in entries(path)[before:]) if path else False
        if model and asked:
            return session_id
        if process.poll() not in (None, 0):
            raise Refusal(f'Claude Code exited {process.returncode} before admission was confirmed. Log: {log}')
        time.sleep(0.2)
    raise Refusal(f'Claude Code admission was not confirmed in {window:g}s; process {process.pid} '
                  f'may still run. Inspect {log} and the session before reconciling.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('operation', choices=['resolve', 'launch', 'resume', 'finished'])
    for flag in ('model', 'report', 'contract', 'session'):
        parser.add_argument('--' + flag)
    parser.add_argument('--for-operation', choices=['launch', 'resume'])
    args = parser.parse_args()
    operation = args.for_operation if args.operation == 'resolve' else args.operation
    try:
        if not operation or not args.contract:
            raise Refusal('resolve needs --for-operation and every operation needs --contract.')
        if args.operation == 'resolve':
            resolve(args, operation)
            session = args.session
        elif args.operation == 'finished':
            model_id, _ = parse_pin(args.model)
            done = finished(retained_session(args, model_id), model_id)
            session = args.session
        else:
            session = admit(args, operation)
    except Refusal as refusal:
        print(f'claude-launcher: {refusal}', file=sys.stderr)
        return 1
    reply = {'protocol': PROTOCOL, 'api_version': 1, 'operation': operation, 'model': args.model}
    if args.operation == 'finished':
        reply['finished'] = done
    if session:
        reply['session'] = session
    print(json.dumps(reply))
    return 0


if __name__ == '__main__':
    sys.exit(main())
