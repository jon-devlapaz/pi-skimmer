 originalPath = join(directory, \"original.json\");\n  const resultPath = join(directory, \"result.json\");\n  await writeFile(\n    originalPath,\n    JSON.stringify(prepared.original, null, 2) + \"\\n\",\n    { mode: 0o600, flag: \"wx\" },\n  );\n  return { originalPath, resultPath };\n}\n\nexport type ArtifactPaths = Awaited<ReturnType<typeof saveOriginal>>;\n\nexport async function saveResult(outcome: Outcome, paths: ArtifactPaths) {\n  await writeFile(paths.resultPath, JSON.stringify(outcome, null, 2) + \"\\n\", {\n    mode: 0o600,\n    flag: \"wx\",\n  });\n}\n\nexport function present(outcome: Outcome, paths: ArtifactPaths) {\n  const { decisions: _decisions, kept, ...summary } = outcome;\n  const display = {\n    ...summary,\n    original_path: paths.originalPath,\n    result_path: paths.resultPath,\n    output_truncated: false,\n    displayed_count: 0,\n    kept: [] as Record<string, unknown>[],\n  };\n  for (const entry of kept) {\n    const unit =\n      outcome.kind === \"items\"\n        ? { index: entry.index, item: entry.item!, p: entry.p }\n        : {\n            index: entry.index,\n            text: entry.text,\n            start_line: entry.start_line!,\n            end_line: entry.end_line!,\n            p: entry.p,\n          };\n    display.kept.push(unit);\n    display.displayed_count++;\n    if (\n      Buffer.byteLength(JSON.stringify(display, null, 2), \"utf8\") >\n      MAX_OUTPUT_BYTES - 1_000\n    ) {\n      display.kept.pop();\n      display.displayed_count--;\n      break;\n    }\n  }\n  display.output_truncated = display.displayed_count < outcome.kept_count;\n  if (display.output_truncated) {\n    display.warnings = [\n      ...display.warnings,\n      \"Only the display was capped. All kept and unjudged material is in result_path; the complete input is in original_path.\",\n    ];\n  }\n  return display;\n}\n","structuredPatch":[{"oldStart":1,"oldLines":8,"newStart":1,"newLines":23,"lines":["-import { mkdtemp, writeFile } from \"node:fs/promises\";","+import {","+  lstat,","+  mkdtemp,","+  readdir,","+  rmdir,","+  unlink,","+  writeFile,","+} from \"node:fs/promises\";"," import { tmpdir } from \"node:os\";"," import { join } from \"node:path\";"," import { MAX_OUTPUT_BYTES, type Outcome, type Prepared } from \"./core.ts\";"," ","+// A skim is capped at 30 seconds, so anything modified within this window may","+// belong to a skim in another Pi session or to a result nobody has read yet.","+export const IDLE_MS = 5 * 60_000;","+","+// mkdtemp appends six alphanumeric characters to the prefix.","+const FOLDER_SHAPE = /^pi-skimmer-[A-Za-z0-9]{6}$/;","+const FOLDER_FILES = new Set([\"original.json\", \"result.json\"]);","+"," export async function saveOriginal(prepared: Prepared, root = tmpdir()) {","   const directory = await mkdtemp(join(root, \"pi-skimmer-\"));","   const originalPath = join(directory, \"original.json\");"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_01FP2PqjRrasw1rsW7gPHzPT","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5-5","id":"msg_011CgS94wnW7QqQXjR57hDma","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01C8xvt3gWPiBPBKPSshHqYP","name":"Edit","input":{"replace_all":false,"file_path":"/Users/jondev/dev/worktrees/pi-skimmer/i-delete-pi-skimmer-s-leftover-recovery-folders-myself-from-within-pi-using-a-sk/extensions/skimmer/artifacts.ts","old_string":"export function present(","new_string":"export interface CleanReport {\n  removed: number;\n  recent: number;\n  unrecognised: number;\n  failed: number;\n}\n\ntype Verdict = keyof CleanReport | \"gone\";\n\nfunction missing(error: unknown) {\n  return (error as NodeJS.ErrnoException).code === \"ENOENT\";\n}\n\nasync function cleanFolder(\n  directory: string,\n  active: ReadonlySet<string>,\n  idleMs: number,\n): Promise<Verdict> {\n  if (active.has(directory)) return \"recent\";\n  const uid = process.getuid?.();\n  try {\n    // lstat so a symlink is never followed.\n    const info = await lstat(directory);\n    if (!info.isDirectory() || (uid !== undefined && info.uid !== uid))\n      return \"unrecognised\";\n    const names = await readdir(directory);\n    let modified = info.mtimeMs;\n    for (const name of names) {\n      if (!FOLDER_FILES.has(name)) return \"unrecognised\";\n      const file = await lstat(join(directory, name));\n      if (!file.isFile() || (uid !== undefined && file.uid !== uid))\n        return \"unrecognised\";\n      modified = Math.max(modified, file.mtimeMs);\n    }\n    if (Date.now() - modified < idleMs) return \"recent\";\n    for (const name of names) await unlink(join(directory, name));\n    // rmdir, not a recursive remove: a file added meanwhile makes this fail.\n    await rmdir(directory);\n    return \"removed\";\n  } catch (error) {\n    return missing(error) ? \"gone\" : \"failed\";\n  }\n}\n\nexport async function cleanArtifacts(\n  root = tmpdir(),\n  options: { active?: ReadonlySet<string>; idleMs?: number } = {},\n): Promise<CleanReport> {\n  const report: CleanReport = {\n    removed: 0,\n    recent: 0,\n    unrecognised: 0,\n    failed: 0,\n  };\n  let names: string[];\n  try {\n    names = await readdir(root);\n  } catch (error) {\n    if (missing(error)) return report;\n    throw error;\n  }\n  for (const name of names) {\n    if (!FOLDER_SHAPE.test(name)) continue;\n    const verdict = await cleanFolder(\n      join(root, name),\n      options.active ?? new Set(),\n      options.idleMs ?? IDLE_MS,\n    );\n    if (verdict !== \"gone\") report[verdict]++;\n  }\n  return report;\n}\n\nexport function describeClean(report: CleanReport) {\n  const plural = (count: number) => (count === 1 ? \"folder\" : \"folders\");\n  const message = `Removed ${report.removed} recovery ${plural(report.removed)}.`;\n  const reasons = [\n    report.recent > 0 &&\n      `${report.recent} in progress or modified within the last ${IDLE_MS / 60_000} minutes (run /skim clean again later)`,\n    report.unrecognised > 0 &&\n      `${report.unrecognised} not a plain pi-skimmer folder (symlink, other owner, or unexpected contents)`,\n    report.failed > 0 && `${report.failed} could not be removed`,\n  ].filter(Boolean);\n  if (reasons.length === 0) return message;\n  const skipped = report.recent + report.unrecognised + report.failed;\n  return `${message} Skipped ${skipped}: ${reasons.join(\"; \")}.`;\n}\n\nexport function present("},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7719,"cache_read_input_tokens":50557,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7719},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f309f9c8-1473-4f76-8d79-3d58dcb79201","uuid":"25cda498-9e63-48af-8f5d-2d888772f9a3","