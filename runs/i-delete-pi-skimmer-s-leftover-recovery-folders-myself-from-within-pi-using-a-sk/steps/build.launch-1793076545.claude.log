{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SeEsrwXxj8uPoZkPgw8tk3","type":"tool_result","content":"1\timport type {\n2\t  ExtensionAPI,\n3\t  ExtensionContext,\n4\t} from \"@earendil-works/pi-coding-agent\";\n5\timport { Type } from \"typebox\";\n6\timport {\n7\t  authState,\n8\t  backendHost,\n9\t  createTypeSafe,\n10\t  describeAuth,\n11\t  type TypeSafe,\n12\t} from \"pi-typesafe\";\n13\timport {\n14\t  jsonValue,\n15\t  judgePrepared,\n16\t  prepareFilter,\n17\t  prepareSkim,\n18\t  type Prepared,\n19\t} from \"./core.ts\";\n20\timport { present, saveOriginal, saveResult } from \"./artifacts.ts\";\n21\t\n22\tinterface Dependencies {\n23\t  createClient(): TypeSafe;\n24\t  auth(): { usable: boolean; text: string; backend: string };\n25\t  environment: NodeJS.ProcessEnv;\n26\t  artifactRoot?: string;\n27\t}\n28\t\n29\tconst defaults: Dependencies = {\n30\t  createClient: () =>\n31\t    createTypeSafe({ maxRequests: 100, maxUsdPerDay: 1, timeoutMs: 10_000 }),\n32\t  auth: () => {\n33\t    const state = authState();\n34\t    return {\n35\t      usable: state.usable,\n36\t      text: describeAuth(state).text,\n37\t      backend: backendHost(state.backend),\n38\t    };\n39\t  },\n40\t  environment: process.env,\n41\t};\n42\t\n43\tfunction disclosure(backend: string): string {\n44\t  const host = new URL(backend.includes(\"://\") ? backend : `https://${backend}`)\n45\t    .host;\n46\t  return `Skimming sends the supplied text or selected item fields, goal, and source label to ${host} and may incur charges. Spending is estimated, not a billing guarantee. Only submit approved, nonsensitive material. Obvious credential checks are not comprehensive secret detection. Owner-only local recovery files retain the complete input and output. /skim disable stops future requests and cancels active skims. This permission is separate from /typesafe enable.`;\n47\t}\n48\tconst guidelines = [\n49\t  \"Use skim_text or filter_items for large, approved, nonsensitive material with a specific goal; not as exhaustive verification. They require separate /skim enable consent (or operator-set PI_SKIMMER_ENABLED=1).\",\n50\t  \"Do not replace every read with skimming. For critical decisions inspect the original, including constraints and exceptions. A relevance probability is not proof or authorization.\",\n51\t  \"These tools never fetch URLs, open source files, or expand grep paths. Submit material already obtained through approved tools. Never submit credentials or private data without authorization.\",\n52\t];\n53\t\n54\tconst outputSchema = Type.Object({\n55\t  kind: Type.Union([Type.Literal(\"text\"), Type.Literal(\"items\")]),\n56\t  source: Type.String(),\n57\t  status: Type.Union([Type.Literal(\"complete\"), Type.Literal(\"degraded\")]),\n58\t  threshold: Type.Number(),\n59\t  total_count: Type.Integer(),\n60\t  kept_count: Type.Integer(),\n61\t  omitted_count: Type.Integer(),\n62\t  unjudged_count: Type.Integer(),\n63\t  input_chars: Type.Integer(),\n64\t  kept_chars: Type.Integer(),\n65\t  input_truncated: Type.Literal(false),\n66\t  output_truncated: Type.Boolean(),\n67\t  displayed_count: Type.Integer(),\n68\t  original_path: Type.String(),\n69\t  result_path: Type.String(),\n70\t  warnings: Type.Array(Type.String()),\n71\t  model: Type.Union([Type.String(), Type.Null()]),\n72\t  usage: Type.Object({\n73\t    input_tokens: Type.Integer(),\n74\t    output_tokens: Type.Integer(),\n75\t    estimated_usd: Type.Number(),\n76\t  }),\n77\t  kept: Type.Array(\n78\t    Type.Object({\n79\t      index: Type.Integer(),\n80\t      p: Type.Union([Type.Number(), Type.Null()]),\n81\t      text: Type.Optional(Type.String()),\n82\t      start_line: Type.Optional(Type.Integer()),\n83\t      end_line: Type.Optional(Type.Integer()),\n84\t      item: Type.Optional(Type.Unknown()),\n85\t    }),\n86\t  ),\n87\t});\n88\t\n89\texport default function skimmer(\n90\t  pi: ExtensionAPI,\n91\t  dependencies: Dependencies = defaults,\n92\t) {\n93\t  let client: TypeSafe | undefined;\n94\t  let clientBackend: string | undefined;\n95\t  let session: string | undefined;\n96\t  let scope: string | undefined;\n97\t  let approvedScope: string | undefined;\n98\t  let approvedBackend: string | undefined;\n99\t  let generation = 0;\n100\t  let lifetime = new AbortController();\n101\t  let lastSummary = \"No material processed.\";\n102\t\n103\t  function synchronize(ctx: ExtensionContext) {\n104\t    const id = ctx.sessionManager.getSessionId();\n105\t    const next = JSON.stringify([id, ctx.cwd]);\n106\t    if (scope === next) return;\n107\t    lifetime.abort();\n108\t    lifetime = new AbortController();\n109\t    generation++;\n110\t    if (session !== id) {\n111\t      client = undefined;\n112\t      clientBackend = undefined;\n113\t      lastSummary = \"No material processed.\";\n114\t    }\n115\t    session = id;\n116\t    scope = next;\n117\t    approvedScope =\n118\t      dependencies.environment.PI_SKIMMER_ENABLED === \"1\" ? scope : undefined;\n119\t    approvedBackend = approvedScope ? dependencies.auth().backend : undefined;\n120\t  }\n121\t\n122\t  function updateStatus(ctx: ExtensionContext) {\n123\t    if (!ctx.hasUI) return;\n124\t    const auth = dependencies.auth();\n125\t    const enabled = approvedScope === scope && approvedBackend === auth.backend;\n126\t    const available = auth.usable;\n127\t    ctx.ui.setStatus(\n128\t      \"skimmer\",\n129\t      enabled ? (available ? \"skim on\" : \"skim unavailable\") : \"skim off\",\n130\t    );\n131\t  }\n132\t\n133\t  function getClient() {\n134\t    const backend = dependencies.auth().backend;\n135\t    if (client && clientBackend !== backend)\n136\t      throw new Error(\n137\t        \"TypeSafe backend changed after the client was created. Start a new Pi session to refresh it without resetting the current request budget.\",\n138\t      );\n139\t    if (!client) {\n140\t      client = dependencies.createClient();\n141\t      clientBackend = backend;\n142\t    }\n143\t    return client;\n144\t  }\n145\t\n146\t  async function execute(\n147\t    prepared: Prepared,\n148\t    signal: AbortSignal | undefined,\n149\t    ctx: ExtensionContext,\n150\t  ) {\n151\t    synchronize(ctx);\n152\t    const authentication = dependencies.auth();\n153\t    if (approvedScope !== scope || approvedBackend !== authentication.backend)\n154\t      throw new Error(\n155\t        \"Skimming is disabled. The operator must run /skim enable, or explicitly set PI_SKIMMER_ENABLED=1 before starting Pi. /typesafe enable does not grant this permission.\",\n156\t      );\n157\t    if (!authentication.usable)\n158\t      throw new Error(\n159\t        \"Jev is unavailable. Check /typesafe status or /typesafe login; no material was sent.\",\n160\t      );\n161\t    const active = AbortSignal.any([\n162\t      lifetime.signal,\n163\t      AbortSignal.timeout(30_000),\n164\t      ...(signal ? [signal] : []),\n165\t    ]);\n166\t    active.throwIfAborted();\n167\t    const currentClient = getClient();\n168\t    const paths = await saveOriginal(prepared, dependencies.artifactRoot);\n169\t    try {\n170\t      const outcome = await judgePrepared(\n171\t        currentClient,\n172\t        prepared,\n173\t        active,\n174\t        currentClient.getSpend().usdPerMTok,\n175\t      );\n176\t      await saveResult(outcome, paths);\n177\t      active.throwIfAborted();\n178\t      const display = jsonValue(present(outcome, paths));\n179\t      lastSummary = `${outcome.kept_count}/${outcome.total_count} retained; ${outcome.unjudged_count} unjudged. ${outcome.status}.`;\n180\t      updateStatus(ctx);\n181\t      const cost = outcome.usage.estimated_usd;\n182\t      return {\n183\t        content: [\n184\t          { type: \"text\" as const, text: JSON.stringify(display, null, 2) },\n185\t        ],\n186\t        details: { ...paths, status: outcome.status },\n187\t        structuredContent: display,\n188\t        isError: outcome.status === \"degraded\",\n189\t        usage: {\n190\t          input: outcome.usage.input_tokens,\n191\t          output: outcome.usage.output_tokens,\n192\t          cacheRead: 0,\n193\t          cacheWrite: 0,\n194\t          totalTokens: outcome.usage.input_tokens + outcome.usage.output_tokens,\n195\t          cost: {\n196\t            input: cost,\n197\t            output: 0,\n198\t            cacheRead: 0,\n199\t            cacheWrite: 0,\n200\t            total: cost,\n201\t          },\n202\t        },\n203\t      };\n204\t    } catch {\n205\t      updateStatus(ctx);\n206\t      throw new Error(\n207\t        `${active.aborted ? \"Skimming cancelled or timed out\" : \"Skimming could not complete\"}. Original input retained at ${paths.originalPath}. No discarded output should be treated as a relevance judgment.`,\n208\t      );\n209\t    }\n210\t  }\n211\t\n212\t  pi.on(\"session_start\", (_event, ctx) => {\n213\t    scope = undefined;\n214\t    session = undefined;\n215\t    synchronize(ctx);\n216\t    updateStatus(ctx);\n217\t  });\n218\t  pi.on(\"session_shutdown\", (_event, ctx) => {\n219\t    lifetime.abort();\n220\t    approvedScope = undefined;\n221\t    approvedBackend = undefined;\n222\t    generation++;\n223\t    if (ctx.hasUI) ctx.ui.setStatus(\"skimmer\", undefined);\n224\t  });\n225\t\n226\t  pi.registerCommand(\"skim\", {\n227\t    description:\n228\t      \"Enable/disable external Jev skimming for this session and working directory, or show status\",\n229\t    async handler(args, ctx) {\n230\t      synchronize(ctx);\n231\t      const action = args.trim() || \"status\";\n232\t      function report(message: string) {\n233\t        if (ctx.hasUI) ctx.ui.notify(message, \"info\");\n234\t        else\n235\t          pi.sendMessage(\n236\t            { customType: \"skimmer-status\", content: message, display: true },\n237\t            { triggerTurn: false },\n238\t          );\n239\t      }\n240\t      if (action === \"disable\") {\n241\t        approvedScope = undefined;\n242\t        approvedBackend = undefined;\n243\t        lifetime.abort();\n244\t        generation++;\n245\t        updateStatus(ctx);\n246\t        report(\n247\t          \"Skimming disabled; active requests cancelled. Recovery files are retained.\",\n248\t        );\n249\t        return;\n250\t      }\n251\t      if (action === \"enable\") {\n252\t        const authentication = dependencies.auth();\n253\t        if (!authentication.usable)\n254\t          throw new Error(\n255\t            \"Jev is unavailable; use /typesafe status or /typesafe login first.\",\n256\t          );\n257\t        if (\n258\t          approvedScope !== scope ||\n259\t          approvedBackend !== authentication.backend\n260\t        ) {\n261\t          if (!ctx.hasUI)\n262\t            throw new Error(\n263\t              \"Interactive consent is required. For headless use, the operator must set PI_SKIMMER_ENABLED=1 before starting Pi.\",\n264\t            );\n265\t          const currentGeneration = generation;\n266\t          const accepted = await ctx.ui.confirm(\n267\t            \"Enable external skimming?\",\n268\t            disclosure(authentication.backend),\n269\t          );\n270\t          synchronize(ctx);\n271\t          if (!accepted) return;\n272\t          if (currentGeneration !== generation)\n273\t            throw new Error(\n274\t              \"Session or consent changed while confirming. Run /skim enable again.\",\n275\t            );\n276\t          const currentAuth = dependencies.auth();\n277\t          if (!currentAuth.usable)\n278\t            throw new Error(\"Jev became unavailable; nothing was enabled.\");\n279\t          if (currentAuth.backend !== authentication.backend)\n280\t            throw new Error(\n281\t              \"Jev backend changed; confirm its destination again.\",\n282\t            );\n283\t          lifetime.abort();\n284\t          lifetime = new AbortController();\n285\t          approvedScope = scope;\n286\t          approvedBackend = authentication.backend;\n287\t          generation++;\n288\t        }\n289\t        updateStatus(ctx);\n290\t        report(\n291\t          \"Skimming enabled for this session and working directory. Up to 100 Jev requests per session; the shared estimated daily budget is at most $1 (lower PI_TYPESAFE_MAX_* caps apply). /skim disable stops it.\",\n292\t        );\n293\t        return;\n294\t      }\n295\t      if (action !== \"status\")\n296\t        throw new Error(\"Usage: /skim enable | disable | status\");\n297\t      const auth = dependencies.auth();\n298\t      const spend = auth.usable ? getClient().getSpend() : undefined;\n299\t      report(\n300\t        `Skimming: ${approvedScope === scope && approvedBackend === auth.backend ? \"consent granted\" : \"disabled\"}. ${auth.text} ${lastSummary} ${spend ? JSON.stringify(spend) : \"Spend unavailable until Jev credentials are usable.\"} ${disclosure(auth.backend)}`,\n301\t      );\n302\t    },\n303\t  });\n304\t\n305\t  pi.registerTool({\n306\t    name: \"skim_text\",\n307\t    label: \"Skim Text\",\n308\t    description:\n309\t      \"Use Jev to retain goal-relevant portions of already supplied, approved nonsensitive text. Does not fetch URLs or read files. Requires /skim enable; data leaves this machine. Defaults: 2000-character chunks, 10% overlap, threshold 0.5. Input over 256000 UTF-8 JSON bytes fails instead of truncating. Unjudged chunks are retained; all originals and full results have owner-only recovery paths. Filtering is not exhaustive verification.\",\n310\t    promptSnippet:\n311\t      \"Filter large approved text with Jev, preserving citations and recovery paths\",\n312\t    promptGuidelines: guidelines,\n313\t    parameters: Type.Object(\n314\t      {\n315\t        text: Type.String({ minLength: 1 }),\n316\t        goal: Type.String({ minLength: 1, maxLength: 2_000 }),\n317\t        source: Type.Optional(\n318\t          Type.String({\n319\t            maxLength: 500,\n320\t            description:\n321\t              \"Display label only; never fetched or opened. Sent to Jev.\",\n322\t          }),\n323\t        ),\n324\t        threshold: Type.Optional(Type.Number({ minimum: 0, maximum: 1 })),\n325\t        chunk_chars: Type.Optional(\n326\t          Type.Integer({ minimum: 500, maximum: 8_000 }),\n327\t        ),\n328\t        overlap: Type.Optional(Type.Number({ minimum: 0, maximum: 0.5 })),\n329\t      },\n330\t      { additionalProperties: false },\n331\t    ),\n332\t    outputSchema,\n333\t    executionMode: \"sequential\",\n334\t    annotations: {\n335\t      readOnlyHint: false,\n336\t      destructiveHint: false,\n337\t      openWorldHint: true,\n338\t    },\n339\t    async execute(_id, params, signal, _onUpdate, ctx) {\n340\t      return execute(prepareSkim(params), signal, ctx);\n341\t    },\n342\t  });\n343\t\n344\t  pi.registerTool({\n345\t    name: \"filter_items\",\n346\t    label: \"Filter Items\",\n347\t    description:\n348\t      \"Use Jev to filter 1–256 supplied JSON items by a specific goal, preserving original order and values. Requires separate /skim enable consent. fields selects literal top-level fields for every object; any missing field fails the entire call before transmission, never falls back. Only selected fields go to Jev; kept items and local recovery files retain original fields. No silent item truncation or top-N cap; API failures retain unjudged items with warnings. Do not submit credentials. Input limit: 256000 UTF-8 JSON bytes.\",\n349\t    promptSnippet:\n350\t      \"Filter approved lists with strict field projection and explicit unjudged results\",\n351\t    parameters: Type.Object(\n352\t      {\n353\t        items: Type.Array(Type.Unknown(), { minItems: 1, maxItems: 256 }),\n354\t        goal: Type.String({ minLength: 1, maxLength: 2_000 }),\n355\t        fields: Type.Optional(\n356\t          Type.Array(Type.String({ minLength: 1, maxLength: 100 }), {\n357\t            minItems: 1,\n358\t            maxItems: 20,\n359\t            uniqueItems: true,\n360\t          }),\n361\t        ),\n362\t        threshold: Type.Optional(Type.Number({ minimum: 0, maximum: 1 })),\n363\t      },\n364\t      { additionalProperties: false },\n365\t    ),\n366\t    outputSchema,\n367\t    executionMode: \"sequential\",\n368\t    annotations: {\n369\t      readOnlyHint: false,\n370\t      destructiveHint: false,\n371\t      openWorldHint: true,\n372\t    },\n373\t    async execute(_id, params, signal, _onUpdate, ctx) {\n374\t      return execute(prepareFilter(params), signal, ctx);\n375\t    },\n376\t  });\n377\t}\n378\t"}]},"parent_tool_use_id":null,"session_id":"f309f9c8-1473-4f76-8d79-3d58dcb79201","uuid":"4fe5907e-684d-4ac8-a925-9fc9da332de6","timestamp":"2026-10-27T04:49:21.012Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jondev/dev/worktrees/pi-skimmer/i-delete-pi-skimmer-s-leftover-recovery-folders-myself-from-within-pi-using-a-sk/extensions/skimmer/index.ts","content":"import type {\n  ExtensionAPI,\n  ExtensionContext,\n} from \"@earendil-works/pi-coding-agent\";\nimport { Type } from \"typebox\";\nimport {\n  authState,\n  backendHost,\n  createTypeSafe,\n  describeAuth,\n  type TypeSafe,\n} from \"pi-typesafe\";\nimport {\n  jsonValue,\n  judgePrepared,\n  prepareFilter,\n  prepareSkim,\n  type Prepared,\n} from \"./core.ts\";\nimport { present, saveOriginal, saveResult } from \"./artifacts.ts\";\n\ninterface Dependencies {\n  createClient(): TypeSafe;\n  auth(): { usable: boolean; text: string; backend: string };\n  environment: NodeJS.ProcessEnv;\n  artifactRoot?: string;\n}\n\nconst defaults: Dependencies = {\n  createClient: () =>\n    createTypeSafe({ maxRequests: 100, maxUsdPerDay: 1, timeoutMs: 10_000 }),\n  auth: () => {\n    const state = authState();\n    return {\n      usable: state.usable,\n      text: describeAuth(state).text,\n      backend: backendHost(state.backend),\n    };\n  },\n  environment: process.env,\n};\n\nfunction disclosure(backend: string): string {\n  const host = new URL(backend.includes(\"://\") ? backend : `https://${backend}`)\n    .host;\n  return `Skimming sends the supplied text or selected item fields, goal, and source label to ${host} and may incur charges. Spending is estimated, not a billing guarantee. Only submit approved, nonsensitive material. Obvious credential checks are not comprehensive secret detection. Owner-only local recovery files retain the complete input and output. /skim disable stops future requests and cancels active skims. This permission is separate from /typesafe enable.`;\n}\nconst guidelines = [\n  \"Use skim_text or filter_items for large, approved, nonsensitive material with a specific goal; not as exhaustive verification. They require separate /skim enable consent (or operator-set PI_SKIMMER_ENABLED=1).\",\n  \"Do not replace every read with skimming. For critical decisions inspect the original, including constraints and exceptions. A relevance probability is not proof or authorization.\",\n  \"These tools never fetch URLs, open source files, or expand grep paths. Submit material already obtained through approved tools. Never submit credentials or private data without authorization.\",\n];\n\nconst outputSchema = Type.Object({\n  kind: Type.Union([Type.Literal(\"text\"), Type.Literal(\"items\")]),\n  source: Type.String(),\n  status: Type.Union([Type.Literal(\"complete\"), Type.Literal(\"degraded\")]),\n  threshold: Type.Number(),\n  total_count: Type.Integer(),\n  kept_count: Type.Integer(),\n  omitted_count: Type.Integer(),\n  unjudged_count: Type.Integer(),\n  input_chars: Type.Integer(),\n  kept_chars: Type.Integer(),\n  input_truncated: Type.Literal(false),\n  output_truncated: Type.Boolean(),\n  displayed_count: Type.Integer(),\n  original_path: Type.String(),\n  result_path: Type.String(),\n  warnings: Type.Array(Type.String()),\n  model: Type.Union([Type.String(), Type.Null()]),\n  usage: Type.Object({\n    input_tokens: Type.Integer(),\n    output_tokens: Type.Integer(),\n    estimated_usd: Type.Number(),\n  }),\n  kept: Type.Array(\n    Type.Object({\n      index: Type.Integer(),\n      p: Type.Union([Type.Number(), Type.Null()]),\n      text: Type.Optional(Type.String()),\n      start_line: Type.Optional(Type.Integer()),\n      end_line: Type.Optional(Type.Integer()),\n      item: Type.Optional(Type.Unknown()),\n    }),\n  ),\n});\n\nexport default function skimmer(\n  pi: ExtensionAPI,\n  dependencies: Dependencies = defaults,\n) {\n  let client: TypeSafe | undefined;\n  let clientBackend: string | undefined;\n  let session: string | undefined;\n  let scope: string | undefined;\n  let approvedScope: string | undefined;\n  let approvedBackend: string | undefined;\n  let generation = 0;\n  let lifetime = new AbortController();\n  let lastSummary = \"No material processed.\";\n\n  function synchronize(ctx: ExtensionContext) {\n    const id = ctx.sessionManager.getSessionId();\n    const next = JSON.stringify([id, ctx.cwd]);\n    if (scope === next) return;\n    lifetime.abort();\n    lifetime = new AbortController();\n    generation++;\n    if (session !== id) {\n      client = undefined;\n      clientBackend = undefined;\n      lastSummary = \"No material processed.\";\n    }\n    session = id;\n    scope = next;\n    approvedScope =\n      dependencies.environment.PI_SKIMMER_ENABLED === \"1\" ? scope : undefined;\n    approvedBackend = approvedScope ? dependencies.auth().backend : undefined;\n  }\n\n  function updateStatus(ctx: ExtensionContext) {\n    if (!ctx.hasUI) return;\n    const auth = dependencies.auth();\n    const enabled = approvedScope === scope && approvedBackend === auth.backend;\n    const available = auth.usable;\n    ctx.ui.setStatus(\n      \"skimmer\",\n      enabled ? (available ? \"skim on\" : \"skim unavailable\") : \"skim off\",\n    );\n  }\n\n  function getClient() {\n    const backend = dependencies.auth().backend;\n    if (client && clientBackend !== backend)\n      throw new Error(\n        \"TypeSafe backend changed after the client was created. Start a new Pi session to refresh it without resetting the current request budget.\",\n      );\n    if (!client) {\n      client = dependencies.createClient();\n      clientBackend = backend;\n    }\n    return client;\n  }\n\n  async function execute(\n    prepared: Prepared,\n    signal: AbortSignal | undefined,\n    ctx: ExtensionContext,\n  ) {\n    synchronize(ctx);\n    const authentication = dependencies.auth();\n    if (approvedScope !== scope || approvedBackend !== authentication.backend)\n      throw new Error(\n        \"Skimming is disabled. The operator must run /skim enable, or explicitly set PI_SKIMMER_ENABLED=1 before starting Pi. /typesafe enable does not grant this permission.\",\n      );\n    if (!authentication.usable)\n      throw new Error(\n        \"Jev is unavailable. Check /typesafe status or /typesafe login; no material was sent.\",\n      );\n    const active = AbortSignal.any([\n      lifetime.signal,\n      AbortSignal.timeout(30_000),\n      ...(signal ? [signal] : []),\n    ]);\n    active.throwIfAborted();\n    const currentClient = getClient();\n    const paths = await saveOriginal(prepared, dependencies.artifactRoot);\n    try {\n      const outcome = await judgePrepared(\n        currentClient,\n        prepared,\n        active,\n        currentClient.getSpend().usdPerMTok,\n      );\n      await saveResult(outcome, paths);\n      active.throwIfAborted();\n      const display = jsonValue(present(outcome, paths));\n      lastSummary = `${outcome.kept_count}/${outcome.total_count} retained; ${outcome.unjudged_count} unjudged. ${outcome.status}.`;\n      updateStatus(ctx);\n      const cost = outcome.usage.estimated_usd;\n      return {\n        content: [\n          { type: \"text\" as const, text: JSON.stringify(display, null, 2) },\n        ],\n        details: { ...paths, status: outcome.status },\n        structuredContent: display,\n        isError: outcome.status === \"degraded\",\n        usage: {\n          input: outcome.usage.input_tokens,\n          output: outcome.usage.output_tokens,\n          cacheRead: 0,\n          cacheWrite: 0,\n          totalTokens: outcome.usage.input_tokens + outcome.usage.output_tokens,\n          cost: {\n            input: cost,\n            output: 0,\n            cacheRead: 0,\n            cacheWrite: 0,\n            total: cost,\n          },\n        },\n      };\n    } catch {\n      updateStatus(ctx);\n      throw new Error(\n        `${active.aborted ? \"Skimming cancelled or timed out\" : \"Skimming could not complete\"}. Original input retained at ${paths.originalPath}. No discarded output should be treated as a relevance judgment.`,\n      );\n    }\n  }\n\n  pi.on(\"session_start\", (_event, ctx) => {\n    scope = undefined;\n    session = undefined;\n    synchronize(ctx);\n    updateStatus(ctx);\n  });\n  pi.on(\"session_shutdown\", (_event, ctx) => {\n    lifetime.abort();\n    approvedScope = undefined;\n    approvedBackend = undefined;\n    generation++;\n    if (ctx.hasUI) ctx.ui.setStatus(\"skimmer\", undefined);\n  });\n\n  pi.registerCommand(\"skim\", {\n    description:\n      \"Enable/disable external Jev skimming for this session and working directory, or show status\",\n    async handler(args, ctx) {\n      synchronize(ctx);\n      const action = args.trim() || \"status\";\n      function report(message: string) {\n        if (ctx.hasUI) ctx.ui.notify(message, \"info\");\n        else\n          pi.sendMessage(\n            { customType: \"skimmer-status\", content: message, display: true },\n            { triggerTurn: false },\n          );\n      }\n      if (action === \"disable\") {\n        approvedScope = undefined;\n        approvedBackend = undefined;\n        lifetime.abort();\n        generation++;\n        updateStatus(ctx);\n        report(\n          \"Skimming disabled; active requests cancelled. Recovery files are retained.\",\n        );\n        return;\n      }\n      if (action === \"enable\") {\n        const authentication = dependencies.auth();\n        if (!authentication.usable)\n          throw new Error(\n            \"Jev is unavailable; use /typesafe status or /typesafe login first.\",\n          );\n        if (\n          approvedScope !== scope ||\n          approvedBackend !== authentication.backend\n        ) {\n          if (!ctx.hasUI)\n            throw new Error(\n              \"Interactive consent is required. For headless use, the operator must set PI_SKIMMER_ENABLED=1 before starting Pi.\",\n            );\n          const currentGeneration = generation;\n          const accepted = await ctx.ui.confirm(\n            \"Enable external skimming?\",\n            disclosure(authentication.backend),\n          );\n          synchronize(ctx);\n          if (!accepted) return;\n          if (currentGeneration !== generation)\n            throw new Error(\n              \"Session or consent changed while confirming. Run /skim enable again.\",\n            );\n          const currentAuth = dependencies.auth();\n          if (!currentAuth.usable)\n            throw new Error(\"Jev became unavailable; nothing was enabled.\");\n          if (currentAuth.backend !== authentication.backend)\n            throw new Error(\n              \"Jev backend changed; confirm its destination again.\",\n            );\n          lifetime.abort();\n          lifetime = new AbortController();\n          approvedScope = scope;\n          approvedBackend = authentication.backend;\n          generation++;\n        }\n        updateStatus(ctx);\n        report(\n          \"Skimming enabled for this session and working directory. Up to 100 Jev requests per session; the shared estimated daily budget is at most $1 (lower PI_TYPESAFE_MAX_* caps apply). /skim disable stops it.\",\n        );\n        return;\n      }\n      if (action !== \"status\")\n        throw new Error(\"Usage: /skim enable | disable | status\");\n      const auth = dependencies.auth();\n      const spend = auth.usable ? getClient().getSpend() : undefined;\n      report(\n        `Skimming: ${approvedScope === scope && approvedBackend === auth.backend ? \"consent granted\" : \"disabled\"}. ${auth.text} ${lastSummary} ${spend ? JSON.stringify(spend) : \"Spend unavailable until Jev credentials are usable.\"} ${disclosure(auth.backend)}`,\n      );\n    },\n  });\n\n  pi.registerTool({\n    name: \"skim_text\",\n    label: \"Skim Text\",\n    description:\n      \"Use Jev to retain goal-relevant portions of already supplied, approved nonsensitive text. Does not fetch URLs or read files. Requires /skim enable; data leaves this machine. Defaults: 2000-character chunks, 10% overlap, threshold 0.5. Input over 256000 UTF-8 JSON bytes fails instead of truncating. Unjudged chunks are retained; all originals and full results have owner-only recovery paths. Filtering is not exhaustive verification.\",\n    promptSnippet:\n      \"Filter large approved text with Jev, preserving citations and recovery paths\",\n    promptGuidelines: guidelines,\n    parameters: Type.Object(\n      {\n        text: Type.String({ minLength: 1 }),\n        goal: Type.String({ minLength: 1, maxLength: 2_000 }),\n        source: Type.Optional(\n          Type.String({\n            maxLength: 500,\n            description:\n              \"Display label only; never fetched or opened. Sent to Jev.\",\n          }),\n        ),\n        threshold: Type.Optional(Type.Number({ minimum: 0, maximum: 1 })),\n        chunk_chars: Type.Optional(\n          Type.Integer({ minimum: 500, maximum: 8_000 }),\n        ),\n        overlap: Type.Optional(Type.Number({ minimum: 0, maximum: 0.5 })),\n      },\n      { additionalProperties: false },\n    ),\n    outputSchema,\n    executionMode: \"sequential\",\n    annotations: {\n      readOnlyHint: false,\n      destructiveHint: false,\n      openWorldHint: true,\n    },\n    async execute(_id, params, signal, _onUpdate, ctx) {\n      return execute(prepareSkim(params), signal, ctx);\n    },\n  });\n\n  pi.registerTool({\n    name: \"filter_items\",\n    label: \"Filter Items\",\n    description:\n      \"Use Jev to filter 1–256 supplied JSON items by a specific goal, preserving original order and values. Requires separate /skim enable consent. fields selects literal top-level fields for every object; any missing field fails the entire call before transmission, never falls back. Only selected fields go to Jev; kept items and local recovery files retain original fields. No silent item truncation or top-N cap; API failures retain unjudged items with warnings. Do not submit credentials. Input limit: 256000 UTF-8 JSON bytes.\",\n    promptSnippet:\n      \"Filter approved lists with strict field projection and explicit unjudged results\",\n    parameters: Type.Object(\n      {\n        items: Type.Array(Type.Unknown(), { minItems: 1, maxItems: 256 }),\n        goal: Type.String({ minLength: 1, maxLength: 2_000 }),\n        fields: Type.Optional(\n          Type.Array(Type.String({ minLength: 1, maxLength: 100 }), {\n            minItems: 1,\n            maxItems: 20,\n            uniqueItems: true,\n          }),\n        ),\n        threshold: Type.Optional(Type.Number({ minimum: 0, maximum: 1 })),\n      },\n      { additionalProperties: false },\n    ),\n    outputSchema,\n    executionMode: \"sequential\",\n    annotations: {\n      readOnlyHint: false,\n      destructiveHint: false,\n      openWorldHint: true,\n    },\n    async execute(_id, params, signal, _onUpdate, ctx) {\n      return execute(prepareFilter(params), signal, ctx);\n    },\n  });\n}\n","numLines":378,"startLine":1,"totalLines":378}},"tool_result_meta":[{"id":"toolu_01SeEsrwXxj8uPoZkPgw8tk3","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
