{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cd41TMSqwJ5DpGvzKTsP1u","type":"tool_result","content":"1\timport assert from \"node:assert/strict\";\n2\timport { mkdtempSync, readFileSync, readdirSync, statSync } from \"node:fs\";\n3\timport { tmpdir } from \"node:os\";\n4\timport { dirname, join } from \"node:path\";\n5\timport test from \"node:test\";\n6\timport register from \"./index.ts\";\n7\timport { MAX_OUTPUT_BYTES } from \"./core.ts\";\n8\t\n9\tfunction harness(\n10\t  options: {\n11\t    enabled?: boolean;\n12\t    hasUI?: boolean;\n13\t    usable?: boolean;\n14\t    backend?: string;\n15\t    probability?: number;\n16\t    evaluate?: (...args: any[]) => any;\n17\t  } = {},\n18\t) {\n19\t  const events = new Map<string, (...args: any[]) => any>();\n20\t  const tools = new Map<string, any>();\n21\t  const commands = new Map<string, any>();\n22\t  const notifications: string[] = [];\n23\t  const confirmations: string[] = [];\n24\t  const statuses: string[] = [];\n25\t  const requests: any[] = [];\n26\t  const root = mkdtempSync(join(tmpdir(), \"skimmer-test-\"));\n27\t  let id = \"session-one\";\n28\t  let accepted = true;\n29\t  let usable = options.usable ?? true;\n30\t  let backend = options.backend ?? \"api.typesafe.ai\";\n31\t  let constructors = 0;\n32\t  let nextConfirm: (() => Promise<boolean>) | undefined;\n33\t  const spend = {\n34\t    usdPerMTok: 0.042,\n35\t    session: { requestsStarted: 0 },\n36\t    today: { estimatedUsd: 0 },\n37\t    caps: { maxUsdPerDay: 1 },\n38\t  };\n39\t  const client = {\n40\t    getSpend: () => spend,\n41\t    evaluateMany: async (batches: any[], config: any) => {\n42\t      requests.push(...batches);\n43\t      spend.session.requestsStarted += batches.length;\n44\t      if (options.evaluate) return options.evaluate(batches, config);\n45\t      return {\n46\t        ok: true,\n47\t        results: [],\n48\t        failures: 0,\n49\t        skipped: 0,\n50\t        model: \"fixture-model\",\n51\t        answers: Object.fromEntries(\n52\t          batches.flatMap((batch) =>\n53\t            Object.keys(batch.questions).map((key) => [\n54\t              key,\n55\t              { type: \"noul\", noul: options.probability ?? 0.9 },\n56\t            ]),\n57\t          ),\n58\t        ),\n59\t        usage: { input_tokens: 123, output_tokens: 12 },\n60\t        elapsedMs: 1,\n61\t      };\n62\t    },\n63\t  };\n64\t  const ctx: any = {\n65\t    cwd: \"/fixture/project\",\n66\t    hasUI: options.hasUI ?? true,\n67\t    sessionManager: { getSessionId: () => id },\n68\t    ui: {\n69\t      notify: (text: string) => notifications.push(text),\n70\t      setStatus: (_key: string, value: string) => statuses.push(value),\n71\t      confirm: async (_title: string, text: string) => {\n72\t        confirmations.push(text);\n73\t        return nextConfirm ? nextConfirm() : accepted;\n74\t      },\n75\t    },\n76\t  };\n77\t  register(\n78\t    {\n79\t      on: (name: string, fn: any) => events.set(name, fn),\n80\t      registerTool: (tool: any) => tools.set(tool.name, tool),\n81\t      registerCommand: (name: string, command: any) =>\n82\t        commands.set(name, command),\n83\t      sendMessage: (message: any) => notifications.push(message.content),\n84\t    } as any,\n85\t    {\n86\t      createClient: () => {\n87\t        constructors++;\n88\t        return client as any;\n89\t      },\n90\t      auth: () => ({\n91\t        usable,\n92\t        backend,\n93\t        text: usable ? \"Fixture Jev available\" : \"Fixture key unavailable\",\n94\t      }),\n95\t      environment: options.enabled\n96\t        ? { PI_SKIMMER_ENABLED: \"1\" }\n97\t        : { PI_TYPESAFE_ENABLED: \"1\" },\n98\t      artifactRoot: root,\n99\t    },\n100\t  );\n101\t  events.get(\"session_start\")!({}, ctx);\n102\t  return {\n103\t    ctx,\n104\t    tools,\n105\t    commands,\n106\t    events,\n107\t    requests,\n108\t    root,\n109\t    notifications,\n110\t    confirmations,\n111\t    statuses,\n112\t    command: (args: string) => commands.get(\"skim\").handler(args, ctx),\n113\t    execute: (name: string, params: unknown, signal?: AbortSignal) =>\n114\t      tools.get(name).execute(\"fixture-call\", params, signal, undefined, ctx),\n115\t    constructors: () => constructors,\n116\t    accept: (value: boolean) => {\n117\t      accepted = value;\n118\t    },\n119\t    auth: (value: boolean) => {\n120\t      usable = value;\n121\t    },\n122\t    session: (value: string) => {\n123\t      id = value;\n124\t    },\n125\t    backend: (value: string) => {\n126\t      backend = value;\n127\t    },\n128\t    confirm: (fn: () => Promise<boolean>) => {\n129\t      nextConfirm = fn;\n130\t    },\n131\t  };\n132\t}\n133\t\n134\ttest(\"registers only the two explicit-input tools, without replacing reads or fetching\", () => {\n135\t  const h = harness();\n136\t  assert.deepEqual([...h.tools.keys()], [\"skim_text\", \"filter_items\"]);\n137\t  assert.deepEqual([...h.events.keys()], [\"session_start\", \"session_shutdown\"]);\n138\t  assert.equal(h.constructors(), 0);\n139\t  for (const tool of h.tools.values()) {\n140\t    assert.equal(tool.parameters.additionalProperties, false);\n141\t    assert.equal(tool.executionMode, \"sequential\");\n142\t    assert.ok(tool.outputSchema);\n143\t  }\n144\t  assert.ok(!(\"paths\" in h.tools.get(\"skim_text\").parameters.properties));\n145\t  assert.ok(!(\"max\" in h.tools.get(\"filter_items\").parameters.properties));\n146\t});\n147\t\n148\ttest(\"TypeSafe tool consent does not enable skimming, and refused confirmation sends nothing\", async () => {\n149\t  const h = harness();\n150\t  await assert.rejects(\n151\t    h.execute(\"skim_text\", { text: \"hello\", goal: \"greeting\" }),\n152\t    /disabled/,\n153\t  );\n154\t  assert.equal(h.constructors(), 0);\n155\t  assert.deepEqual(readdirSync(h.root), []);\n156\t  h.accept(false);\n157\t  await h.command(\"enable\");\n158\t  assert.match(h.confirmations[0]!, /api.typesafe.ai/);\n159\t  assert.match(h.confirmations[0]!, /complete input and output/);\n160\t  await assert.rejects(\n161\t    h.execute(\"skim_text\", { text: \"hello\", goal: \"greeting\" }),\n162\t    /disabled/,\n163\t  );\n164\t  assert.equal(h.requests.length, 0);\n165\t});\n166\t\n167\ttest(\"bare SDK hosts and host-port endpoints work in enable and status\", async () => {\n168\t  for (const backend of [\"api.typesafe.ai\", \"localhost:8080\"]) {\n169\t    const h = harness({ backend });\n170\t    await h.command(\"enable\");\n171\t    await h.command(\"status\");\n172\t    assert.ok(h.confirmations[0]!.includes(backend));\n173\t    assert.ok(h.notifications.at(-1)!.includes(backend));\n174\t  }\n175\t});\n176\t\n177\ttest(\"consent discloses the configured destination without URL credentials\", async () => {\n178\t  const h = harness({\n179\t    backend: \"https://user:password@fixture.invalid/custom?key=private\",\n180\t  });\n181\t  await h.command(\"enable\");\n182\t  assert.match(h.confirmations[0]!, /fixture.invalid/);\n183\t  assert.ok(!h.confirmations[0]!.includes(\"password\"));\n184\t  assert.ok(!h.confirmations[0]!.includes(\"key=private\"));\n185\t});\n186\t\n187\ttest(\"backend changes require new consent and never reset a cached request budget\", async () => {\n188\t  const h = harness();\n189\t  await h.command(\"enable\");\n190\t  await h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" });\n191\t  h.backend(\"https://other.invalid\");\n192\t  await assert.rejects(\n193\t    h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n194\t    /disabled/,\n195\t  );\n196\t  await h.command(\"enable\");\n197\t  await assert.rejects(\n198\t    h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n199\t    /Start a new Pi session/,\n200\t  );\n201\t  assert.equal(h.constructors(), 1);\n202\t  assert.equal(h.requests.length, 1);\n203\t});\n204\t\n205\ttest(\"a backend change during confirmation cannot acquire consent\", async () => {\n206\t  const h = harness();\n207\t  h.confirm(async () => {\n208\t    h.backend(\"https://other.invalid\");\n209\t    return true;\n210\t  });\n211\t  await assert.rejects(h.command(\"enable\"), /backend changed/);\n212\t  await assert.rejects(\n213\t    h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n214\t    /disabled/,\n215\t  );\n216\t  assert.equal(h.requests.length, 0);\n217\t});\n218\t\n219\ttest(\"explicit consent enables processing, private recovery files and structured output\", async () => {\n220\t  const h = harness();\n221\t  await h.command(\"enable\");\n222\t  const result = await h.execute(\"skim_text\", {\n223\t    text: \"Hello world\\nSecond line\",\n224\t    goal: \"greeting\",\n225\t    source: \"unopened.txt\",\n226\t  });\n227\t  const output = result.structuredContent;\n228\t  assert.equal(output.status, \"complete\");\n229\t  assert.equal(output.input_truncated, false);\n230\t  assert.equal(output.output_truncated, false);\n231\t  assert.equal(output.kept[0].start_line, 1);\n232\t  assert.equal(output.kept[0].end_line, 2);\n233\t  assert.equal(output.kept[0].text, \"Hello world\\nSecond line\");\n234\t  assert.equal(result.isError, false);\n235\t  assert.equal(result.usage.input, 123);\n236\t  assert.equal(result.usage.totalTokens, 135);\n237\t  assert.deepEqual(JSON.parse(result.content[0].text), output);\n238\t  assert.deepEqual(JSON.parse(readFileSync(output.original_path, \"utf8\")), {\n239\t    text: \"Hello world\\nSecond line\",\n240\t    goal: \"greeting\",\n241\t    source: \"unopened.txt\",\n242\t  });\n243\t  assert.equal(\n244\t    JSON.parse(readFileSync(output.result_path, \"utf8\")).kept_count,\n245\t    1,\n246\t  );\n247\t  assert.equal(statSync(output.original_path).mode & 0o777, 0o600);\n248\t  assert.equal(statSync(output.result_path).mode & 0o777, 0o600);\n249\t  assert.equal(statSync(dirname(output.original_path)).mode & 0o777, 0o700);\n250\t});\n251\t\n252\ttest(\"projection failures are rejected before any credential client, artifact or request\", async () => {\n253\t  const h = harness({ enabled: true });\n254\t  await assert.rejects(\n255\t    h.execute(\"filter_items\", {\n256\t      items: [{ title: \"visible\" }, { private: \"SENTINEL\" }],\n257\t      goal: \"find title\",\n258\t      fields: [\"title\"],\n259\t    }),\n260\t    /missing a requested field/,\n261\t  );\n262\t  assert.equal(h.requests.length, 0);\n263\t  assert.equal(h.constructors(), 0);\n264\t  assert.deepEqual(readdirSync(h.root), []);\n265\t});\n266\t\n267\ttest(\"filter output preserves original fields while Jev sees only projected fields\", async () => {\n268\t  const h = harness({ enabled: true });\n269\t  const items = [{ title: \"Visible\", private: \"NOT_FOR_JEV\" }];\n270\t  const result = await h.execute(\"filter_items\", {\n271\t    items,\n272\t    goal: \"find visible\",\n273\t    fields: [\"title\"],\n274\t  });\n275\t  assert.ok(!JSON.stringify(h.requests).includes(\"NOT_FOR_JEV\"));\n276\t  assert.deepEqual(result.structuredContent.kept[0].item, items[0]);\n277\t  assert.ok(\n278\t    result.structuredContent.warnings.some((warning: string) =>\n279\t      warning.includes(\"original fields\"),\n280\t    ),\n281\t  );\n282\t});\n283\t\n284\ttest(\"API degradation is explicitly an error result but retains all unjudged material\", async () => {\n285\t  const h = harness({\n286\t    enabled: true,\n287\t    evaluate: async () => ({\n288\t      answers: {},\n289\t      failures: 2,\n290\t      skipped: 1,\n291\t      usage: { input_tokens: 0, output_tokens: 0 },\n292\t    }),\n293\t  });\n294\t  const items = Array.from({ length: 40 }, (_, i) => i);\n295\t  const result = await h.execute(\"filter_items\", {\n296\t    items,\n297\t    goal: \"find matches\",\n298\t  });\n299\t  assert.equal(result.isError, true);\n300\t  assert.equal(result.structuredContent.status, \"degraded\");\n301\t  assert.equal(result.structuredContent.unjudged_count, 40);\n302\t  assert.deepEqual(\n303\t    result.structuredContent.kept.map((unit: any) => unit.item),\n304\t    items,\n305\t  );\n306\t  assert.equal(result.structuredContent.omitted_count, 0);\n307\t});\n308\t\n309\ttest(\"display limits never discard retained or unjudged material from full results\", async () => {\n310\t  const h = harness({\n311\t    enabled: true,\n312\t    evaluate: async () => ({\n313\t      answers: {},\n314\t      failures: 1,\n315\t      skipped: 0,\n316\t      usage: { input_tokens: 0, output_tokens: 0 },\n317\t    }),\n318\t  });\n319\t  const items = Array.from({ length: 60 }, (_, i) => ({\n320\t    id: i,\n321\t    text: \"x\".repeat(2_000),\n322\t  }));\n323\t  const result = await h.execute(\"filter_items\", {\n324\t    items,\n325\t    goal: \"find matches\",\n326\t  });\n327\t  const output = result.structuredContent;\n328\t  assert.equal(output.kept_count, 60);\n329\t  assert.equal(output.unjudged_count, 60);\n330\t  assert.ok(output.displayed_count < 60);\n331\t  assert.equal(output.output_truncated, true);\n332\t  assert.ok(Buffer.byteLength(JSON.stringify(output)) <= MAX_OUTPUT_BYTES);\n333\t  assert.ok(Buffer.byteLength(result.content[0].text) <= MAX_OUTPUT_BYTES);\n334\t  assert.ok(\n335\t    output.warnings.some((warning: string) =>\n336\t      warning.includes(\"All kept and unjudged\"),\n337\t    ),\n338\t  );\n339\t  const full = JSON.parse(readFileSync(output.result_path, \"utf8\"));\n340\t  assert.equal(full.kept.length, 60);\n341\t  assert.deepEqual(\n342\t    full.kept.map((unit: any) => unit.item),\n343\t    items,\n344\t  );\n345\t});\n346\t\n347\ttest(\"pretty-printed nested items obey the display byte cap without losing full results\", async () => {\n348\t  const h = harness({ enabled: true });\n349\t  const items = Array.from({ length: 24 }, () =>\n350\t    Object.fromEntries([\n351\t      [\"title\", \"keep\"],\n352\t      ...Array.from({ length: 100 }, (_, i) => [`key_${i}`, i]),\n353\t    ]),\n354\t  );\n355\t  const result = await h.execute(\"filter_items\", {\n356\t    items,\n357\t    fields: [\"title\"],\n358\t    goal: \"goal\",\n359\t  });\n360\t  const output = result.structuredContent;\n361\t  assert.equal(output.output_truncated, true);\n362\t  assert.ok(Buffer.byteLength(result.content[0].text) <= MAX_OUTPUT_BYTES);\n363\t  assert.equal(\n364\t    JSON.parse(readFileSync(output.result_path, \"utf8\")).kept.length,\n365\t    24,\n366\t  );\n367\t});\n368\t\n369\ttest(\"session changes, cwd changes and reloads revoke interactive consent\", async () => {\n370\t  const h = harness();\n371\t  await h.command(\"enable\");\n372\t  await h.execute(\"skim_text\", { text: \"hello\", goal: \"greeting\" });\n373\t  h.session(\"session-two\");\n374\t  await assert.rejects(\n375\t    h.execute(\"skim_text\", { text: \"hello\", goal: \"greeting\" }),\n376\t    /disabled/,\n377\t  );\n378\t  await h.command(\"enable\");\n379\t  h.ctx.cwd = \"/different/project\";\n380\t  await assert.rejects(\n381\t    h.execute(\"skim_text\", { text: \"hello\", goal: \"greeting\" }),\n382\t    /disabled/,\n383\t  );\n384\t  await h.command(\"enable\");\n385\t  h.events.get(\"session_start\")!({}, h.ctx);\n386\t  await assert.rejects(\n387\t    h.execute(\"skim_text\", { text: \"hello\", goal: \"greeting\" }),\n388\t    /disabled/,\n389\t  );\n390\t});\n391\t\n392\ttest(\"disable and re-enable do not reset the session request budget\", async () => {\n393\t  const h = harness();\n394\t  await h.command(\"enable\");\n395\t  await h.execute(\"skim_text\", { text: \"one\", goal: \"goal\" });\n396\t  await h.command(\"disable\");\n397\t  await assert.rejects(\n398\t    h.execute(\"skim_text\", { text: \"two\", goal: \"goal\" }),\n399\t    /disabled/,\n400\t  );\n401\t  await h.command(\"enable\");\n402\t  await h.execute(\"skim_text\", { text: \"three\", goal: \"goal\" });\n403\t  assert.equal(h.constructors(), 1);\n404\t  assert.equal(h.requests.length, 2);\n405\t  await h.command(\"status\");\n406\t  assert.match(h.notifications.at(-1)!, /requestsStarted.*2/);\n407\t  assert.match(h.notifications.at(-1)!, /retained/);\n408\t});\n409\t\n410\ttest(\"headless use requires dedicated operator opt-in, never TypeSafe's flag alone\", async () => {\n411\t  const denied = harness({ hasUI: false });\n412\t  await assert.rejects(denied.command(\"enable\"), /PI_SKIMMER_ENABLED/);\n413\t  await assert.rejects(\n414\t    denied.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n415\t    /disabled/,\n416\t  );\n417\t  const allowed = harness({ hasUI: false, enabled: true });\n418\t  const result = await allowed.execute(\"skim_text\", {\n419\t    text: \"hello\",\n420\t    goal: \"goal\",\n421\t  });\n422\t  assert.equal(result.structuredContent.status, \"complete\");\n423\t  await allowed.command(\"disable\");\n424\t  await assert.rejects(\n425\t    allowed.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n426\t    /disabled/,\n427\t  );\n428\t});\n429\t\n430\ttest(\"missing or rejected credentials block transmission and report unavailability\", async () => {\n431\t  const h = harness({ enabled: true, usable: false });\n432\t  await assert.rejects(\n433\t    h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n434\t    /Jev is unavailable/,\n435\t  );\n436\t  assert.equal(h.requests.length, 0);\n437\t  await h.command(\"status\");\n438\t  assert.match(h.notifications.at(-1)!, /unavailable/);\n439\t  assert.equal(h.constructors(), 0);\n440\t  h.auth(true);\n441\t  await h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" });\n442\t  assert.equal(h.constructors(), 1);\n443\t});\n444\t\n445\ttest(\"a confirmation cannot grant consent to a changed session\", async () => {\n446\t  const h = harness();\n447\t  let resolve!: (value: boolean) => void;\n448\t  h.confirm(\n449\t    () =>\n450\t      new Promise<boolean>((done) => {\n451\t        resolve = done;\n452\t      }),\n453\t  );\n454\t  const enabling = h.command(\"enable\");\n455\t  h.session(\"session-two\");\n456\t  h.events.get(\"session_start\")!({}, h.ctx);\n457\t  resolve(true);\n458\t  await assert.rejects(enabling, /consent changed/);\n459\t  await assert.rejects(\n460\t    h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n461\t    /disabled/,\n462\t  );\n463\t});\n464\t\n465\ttest(\"concurrent confirmations cannot replace the active consent lifetime\", async () => {\n466\t  const h = harness();\n467\t  const pending: ((value: boolean) => void)[] = [];\n468\t  h.confirm(() => new Promise<boolean>((resolve) => pending.push(resolve)));\n469\t  const first = h.command(\"enable\");\n470\t  const second = h.command(\"enable\");\n471\t  pending[0]!(true);\n472\t  await first;\n473\t  pending[1]!(true);\n474\t  await assert.rejects(second, /consent changed/);\n475\t  const result = await h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" });\n476\t  assert.equal(result.structuredContent.status, \"complete\");\n477\t});\n478\t\n479\ttest(\"disable cancels an active batch without returning partial verdicts\", async () => {\n480\t  let entered!: () => void;\n481\t  const ready = new Promise<void>((resolve) => {\n482\t    entered = resolve;\n483\t  });\n484\t  const h = harness({\n485\t    enabled: true,\n486\t    evaluate: async (_requests, config) => {\n487\t      entered();\n488\t      await new Promise<void>((resolve) =>\n489\t        config.signal.addEventListener(\"abort\", () => resolve(), {\n490\t          once: true,\n491\t        }),\n492\t      );\n493\t      return {\n494\t        answers: {},\n495\t        failures: 1,\n496\t        skipped: 1,\n497\t        usage: { input_tokens: 0, output_tokens: 0 },\n498\t      };\n499\t    },\n500\t  });\n501\t  const running = h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" });\n502\t  await ready;\n503\t  const rejected = assert.rejects(\n504\t    running,\n505\t    /cancelled.*Original input retained/,\n506\t  );\n507\t  await h.command(\"disable\");\n508\t  await rejected;\n509\t  const artifacts = readdirSync(h.root);\n510\t  assert.equal(artifacts.length, 1);\n511\t  assert.equal(\n512\t    JSON.parse(\n513\t      readFileSync(join(h.root, artifacts[0]!, \"original.json\"), \"utf8\"),\n514\t    ).text,\n515\t    \"hello\",\n516\t  );\n517\t});\n518\t\n519\ttest(\"unexpected transport failures do not expose exception bodies or submitted secrets\", async () => {\n520\t  const h = harness({\n521\t    enabled: true,\n522\t    evaluate: async () => {\n523\t      throw new Error(\"UPSTREAM_PRIVATE_BODY\");\n524\t    },\n525\t  });\n526\t  await assert.rejects(\n527\t    h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n528\t    (error: Error) => {\n529\t      assert.match(error.message, /Original input retained/);\n530\t      assert.ok(!error.message.includes(\"UPSTREAM_PRIVATE_BODY\"));\n531\t      return true;\n532\t    },\n533\t  );\n534\t});\n535\t"}]},"parent_tool_use_id":null,"session_id":"f309f9c8-1473-4f76-8d79-3d58dcb79201","uuid":"95cd42e2-ca3d-47b8-a728-be9250bd7e30","timestamp":"2026-10-27T04:49:21.604Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/jondev/dev/worktrees/pi-skimmer/i-delete-pi-skimmer-s-leftover-recovery-folders-myself-from-within-pi-using-a-sk/extensions/skimmer/index.test.ts","content":"import assert from \"node:assert/strict\";\nimport { mkdtempSync, readFileSync, readdirSync, statSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { dirname, join } from \"node:path\";\nimport test from \"node:test\";\nimport register from \"./index.ts\";\nimport { MAX_OUTPUT_BYTES } from \"./core.ts\";\n\nfunction harness(\n  options: {\n    enabled?: boolean;\n    hasUI?: boolean;\n    usable?: boolean;\n    backend?: string;\n    probability?: number;\n    evaluate?: (...args: any[]) => any;\n  } = {},\n) {\n  const events = new Map<string, (...args: any[]) => any>();\n  const tools = new Map<string, any>();\n  const commands = new Map<string, any>();\n  const notifications: string[] = [];\n  const confirmations: string[] = [];\n  const statuses: string[] = [];\n  const requests: any[] = [];\n  const root = mkdtempSync(join(tmpdir(), \"skimmer-test-\"));\n  let id = \"session-one\";\n  let accepted = true;\n  let usable = options.usable ?? true;\n  let backend = options.backend ?? \"api.typesafe.ai\";\n  let constructors = 0;\n  let nextConfirm: (() => Promise<boolean>) | undefined;\n  const spend = {\n    usdPerMTok: 0.042,\n    session: { requestsStarted: 0 },\n    today: { estimatedUsd: 0 },\n    caps: { maxUsdPerDay: 1 },\n  };\n  const client = {\n    getSpend: () => spend,\n    evaluateMany: async (batches: any[], config: any) => {\n      requests.push(...batches);\n      spend.session.requestsStarted += batches.length;\n      if (options.evaluate) return options.evaluate(batches, config);\n      return {\n        ok: true,\n        results: [],\n        failures: 0,\n        skipped: 0,\n        model: \"fixture-model\",\n        answers: Object.fromEntries(\n          batches.flatMap((batch) =>\n            Object.keys(batch.questions).map((key) => [\n              key,\n              { type: \"noul\", noul: options.probability ?? 0.9 },\n            ]),\n          ),\n        ),\n        usage: { input_tokens: 123, output_tokens: 12 },\n        elapsedMs: 1,\n      };\n    },\n  };\n  const ctx: any = {\n    cwd: \"/fixture/project\",\n    hasUI: options.hasUI ?? true,\n    sessionManager: { getSessionId: () => id },\n    ui: {\n      notify: (text: string) => notifications.push(text),\n      setStatus: (_key: string, value: string) => statuses.push(value),\n      confirm: async (_title: string, text: string) => {\n        confirmations.push(text);\n        return nextConfirm ? nextConfirm() : accepted;\n      },\n    },\n  };\n  register(\n    {\n      on: (name: string, fn: any) => events.set(name, fn),\n      registerTool: (tool: any) => tools.set(tool.name, tool),\n      registerCommand: (name: string, command: any) =>\n        commands.set(name, command),\n      sendMessage: (message: any) => notifications.push(message.content),\n    } as any,\n    {\n      createClient: () => {\n        constructors++;\n        return client as any;\n      },\n      auth: () => ({\n        usable,\n        backend,\n        text: usable ? \"Fixture Jev available\" : \"Fixture key unavailable\",\n      }),\n      environment: options.enabled\n        ? { PI_SKIMMER_ENABLED: \"1\" }\n        : { PI_TYPESAFE_ENABLED: \"1\" },\n      artifactRoot: root,\n    },\n  );\n  events.get(\"session_start\")!({}, ctx);\n  return {\n    ctx,\n    tools,\n    commands,\n    events,\n    requests,\n    root,\n    notifications,\n    confirmations,\n    statuses,\n    command: (args: string) => commands.get(\"skim\").handler(args, ctx),\n    execute: (name: string, params: unknown, signal?: AbortSignal) =>\n      tools.get(name).execute(\"fixture-call\", params, signal, undefined, ctx),\n    constructors: () => constructors,\n    accept: (value: boolean) => {\n      accepted = value;\n    },\n    auth: (value: boolean) => {\n      usable = value;\n    },\n    session: (value: string) => {\n      id = value;\n    },\n    backend: (value: string) => {\n      backend = value;\n    },\n    confirm: (fn: () => Promise<boolean>) => {\n      nextConfirm = fn;\n    },\n  };\n}\n\ntest(\"registers only the two explicit-input tools, without replacing reads or fetching\", () => {\n  const h = harness();\n  assert.deepEqual([...h.tools.keys()], [\"skim_text\", \"filter_items\"]);\n  assert.deepEqual([...h.events.keys()], [\"session_start\", \"session_shutdown\"]);\n  assert.equal(h.constructors(), 0);\n  for (const tool of h.tools.values()) {\n    assert.equal(tool.parameters.additionalProperties, false);\n    assert.equal(tool.executionMode, \"sequential\");\n    assert.ok(tool.outputSchema);\n  }\n  assert.ok(!(\"paths\" in h.tools.get(\"skim_text\").parameters.properties));\n  assert.ok(!(\"max\" in h.tools.get(\"filter_items\").parameters.properties));\n});\n\ntest(\"TypeSafe tool consent does not enable skimming, and refused confirmation sends nothing\", async () => {\n  const h = harness();\n  await assert.rejects(\n    h.execute(\"skim_text\", { text: \"hello\", goal: \"greeting\" }),\n    /disabled/,\n  );\n  assert.equal(h.constructors(), 0);\n  assert.deepEqual(readdirSync(h.root), []);\n  h.accept(false);\n  await h.command(\"enable\");\n  assert.match(h.confirmations[0]!, /api.typesafe.ai/);\n  assert.match(h.confirmations[0]!, /complete input and output/);\n  await assert.rejects(\n    h.execute(\"skim_text\", { text: \"hello\", goal: \"greeting\" }),\n    /disabled/,\n  );\n  assert.equal(h.requests.length, 0);\n});\n\ntest(\"bare SDK hosts and host-port endpoints work in enable and status\", async () => {\n  for (const backend of [\"api.typesafe.ai\", \"localhost:8080\"]) {\n    const h = harness({ backend });\n    await h.command(\"enable\");\n    await h.command(\"status\");\n    assert.ok(h.confirmations[0]!.includes(backend));\n    assert.ok(h.notifications.at(-1)!.includes(backend));\n  }\n});\n\ntest(\"consent discloses the configured destination without URL credentials\", async () => {\n  const h = harness({\n    backend: \"https://user:password@fixture.invalid/custom?key=private\",\n  });\n  await h.command(\"enable\");\n  assert.match(h.confirmations[0]!, /fixture.invalid/);\n  assert.ok(!h.confirmations[0]!.includes(\"password\"));\n  assert.ok(!h.confirmations[0]!.includes(\"key=private\"));\n});\n\ntest(\"backend changes require new consent and never reset a cached request budget\", async () => {\n  const h = harness();\n  await h.command(\"enable\");\n  await h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" });\n  h.backend(\"https://other.invalid\");\n  await assert.rejects(\n    h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n    /disabled/,\n  );\n  await h.command(\"enable\");\n  await assert.rejects(\n    h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n    /Start a new Pi session/,\n  );\n  assert.equal(h.constructors(), 1);\n  assert.equal(h.requests.length, 1);\n});\n\ntest(\"a backend change during confirmation cannot acquire consent\", async () => {\n  const h = harness();\n  h.confirm(async () => {\n    h.backend(\"https://other.invalid\");\n    return true;\n  });\n  await assert.rejects(h.command(\"enable\"), /backend changed/);\n  await assert.rejects(\n    h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n    /disabled/,\n  );\n  assert.equal(h.requests.length, 0);\n});\n\ntest(\"explicit consent enables processing, private recovery files and structured output\", async () => {\n  const h = harness();\n  await h.command(\"enable\");\n  const result = await h.execute(\"skim_text\", {\n    text: \"Hello world\\nSecond line\",\n    goal: \"greeting\",\n    source: \"unopened.txt\",\n  });\n  const output = result.structuredContent;\n  assert.equal(output.status, \"complete\");\n  assert.equal(output.input_truncated, false);\n  assert.equal(output.output_truncated, false);\n  assert.equal(output.kept[0].start_line, 1);\n  assert.equal(output.kept[0].end_line, 2);\n  assert.equal(output.kept[0].text, \"Hello world\\nSecond line\");\n  assert.equal(result.isError, false);\n  assert.equal(result.usage.input, 123);\n  assert.equal(result.usage.totalTokens, 135);\n  assert.deepEqual(JSON.parse(result.content[0].text), output);\n  assert.deepEqual(JSON.parse(readFileSync(output.original_path, \"utf8\")), {\n    text: \"Hello world\\nSecond line\",\n    goal: \"greeting\",\n    source: \"unopened.txt\",\n  });\n  assert.equal(\n    JSON.parse(readFileSync(output.result_path, \"utf8\")).kept_count,\n    1,\n  );\n  assert.equal(statSync(output.original_path).mode & 0o777, 0o600);\n  assert.equal(statSync(output.result_path).mode & 0o777, 0o600);\n  assert.equal(statSync(dirname(output.original_path)).mode & 0o777, 0o700);\n});\n\ntest(\"projection failures are rejected before any credential client, artifact or request\", async () => {\n  const h = harness({ enabled: true });\n  await assert.rejects(\n    h.execute(\"filter_items\", {\n      items: [{ title: \"visible\" }, { private: \"SENTINEL\" }],\n      goal: \"find title\",\n      fields: [\"title\"],\n    }),\n    /missing a requested field/,\n  );\n  assert.equal(h.requests.length, 0);\n  assert.equal(h.constructors(), 0);\n  assert.deepEqual(readdirSync(h.root), []);\n});\n\ntest(\"filter output preserves original fields while Jev sees only projected fields\", async () => {\n  const h = harness({ enabled: true });\n  const items = [{ title: \"Visible\", private: \"NOT_FOR_JEV\" }];\n  const result = await h.execute(\"filter_items\", {\n    items,\n    goal: \"find visible\",\n    fields: [\"title\"],\n  });\n  assert.ok(!JSON.stringify(h.requests).includes(\"NOT_FOR_JEV\"));\n  assert.deepEqual(result.structuredContent.kept[0].item, items[0]);\n  assert.ok(\n    result.structuredContent.warnings.some((warning: string) =>\n      warning.includes(\"original fields\"),\n    ),\n  );\n});\n\ntest(\"API degradation is explicitly an error result but retains all unjudged material\", async () => {\n  const h = harness({\n    enabled: true,\n    evaluate: async () => ({\n      answers: {},\n      failures: 2,\n      skipped: 1,\n      usage: { input_tokens: 0, output_tokens: 0 },\n    }),\n  });\n  const items = Array.from({ length: 40 }, (_, i) => i);\n  const result = await h.execute(\"filter_items\", {\n    items,\n    goal: \"find matches\",\n  });\n  assert.equal(result.isError, true);\n  assert.equal(result.structuredContent.status, \"degraded\");\n  assert.equal(result.structuredContent.unjudged_count, 40);\n  assert.deepEqual(\n    result.structuredContent.kept.map((unit: any) => unit.item),\n    items,\n  );\n  assert.equal(result.structuredContent.omitted_count, 0);\n});\n\ntest(\"display limits never discard retained or unjudged material from full results\", async () => {\n  const h = harness({\n    enabled: true,\n    evaluate: async () => ({\n      answers: {},\n      failures: 1,\n      skipped: 0,\n      usage: { input_tokens: 0, output_tokens: 0 },\n    }),\n  });\n  const items = Array.from({ length: 60 }, (_, i) => ({\n    id: i,\n    text: \"x\".repeat(2_000),\n  }));\n  const result = await h.execute(\"filter_items\", {\n    items,\n    goal: \"find matches\",\n  });\n  const output = result.structuredContent;\n  assert.equal(output.kept_count, 60);\n  assert.equal(output.unjudged_count, 60);\n  assert.ok(output.displayed_count < 60);\n  assert.equal(output.output_truncated, true);\n  assert.ok(Buffer.byteLength(JSON.stringify(output)) <= MAX_OUTPUT_BYTES);\n  assert.ok(Buffer.byteLength(result.content[0].text) <= MAX_OUTPUT_BYTES);\n  assert.ok(\n    output.warnings.some((warning: string) =>\n      warning.includes(\"All kept and unjudged\"),\n    ),\n  );\n  const full = JSON.parse(readFileSync(output.result_path, \"utf8\"));\n  assert.equal(full.kept.length, 60);\n  assert.deepEqual(\n    full.kept.map((unit: any) => unit.item),\n    items,\n  );\n});\n\ntest(\"pretty-printed nested items obey the display byte cap without losing full results\", async () => {\n  const h = harness({ enabled: true });\n  const items = Array.from({ length: 24 }, () =>\n    Object.fromEntries([\n      [\"title\", \"keep\"],\n      ...Array.from({ length: 100 }, (_, i) => [`key_${i}`, i]),\n    ]),\n  );\n  const result = await h.execute(\"filter_items\", {\n    items,\n    fields: [\"title\"],\n    goal: \"goal\",\n  });\n  const output = result.structuredContent;\n  assert.equal(output.output_truncated, true);\n  assert.ok(Buffer.byteLength(result.content[0].text) <= MAX_OUTPUT_BYTES);\n  assert.equal(\n    JSON.parse(readFileSync(output.result_path, \"utf8\")).kept.length,\n    24,\n  );\n});\n\ntest(\"session changes, cwd changes and reloads revoke interactive consent\", async () => {\n  const h = harness();\n  await h.command(\"enable\");\n  await h.execute(\"skim_text\", { text: \"hello\", goal: \"greeting\" });\n  h.session(\"session-two\");\n  await assert.rejects(\n    h.execute(\"skim_text\", { text: \"hello\", goal: \"greeting\" }),\n    /disabled/,\n  );\n  await h.command(\"enable\");\n  h.ctx.cwd = \"/different/project\";\n  await assert.rejects(\n    h.execute(\"skim_text\", { text: \"hello\", goal: \"greeting\" }),\n    /disabled/,\n  );\n  await h.command(\"enable\");\n  h.events.get(\"session_start\")!({}, h.ctx);\n  await assert.rejects(\n    h.execute(\"skim_text\", { text: \"hello\", goal: \"greeting\" }),\n    /disabled/,\n  );\n});\n\ntest(\"disable and re-enable do not reset the session request budget\", async () => {\n  const h = harness();\n  await h.command(\"enable\");\n  await h.execute(\"skim_text\", { text: \"one\", goal: \"goal\" });\n  await h.command(\"disable\");\n  await assert.rejects(\n    h.execute(\"skim_text\", { text: \"two\", goal: \"goal\" }),\n    /disabled/,\n  );\n  await h.command(\"enable\");\n  await h.execute(\"skim_text\", { text: \"three\", goal: \"goal\" });\n  assert.equal(h.constructors(), 1);\n  assert.equal(h.requests.length, 2);\n  await h.command(\"status\");\n  assert.match(h.notifications.at(-1)!, /requestsStarted.*2/);\n  assert.match(h.notifications.at(-1)!, /retained/);\n});\n\ntest(\"headless use requires dedicated operator opt-in, never TypeSafe's flag alone\", async () => {\n  const denied = harness({ hasUI: false });\n  await assert.rejects(denied.command(\"enable\"), /PI_SKIMMER_ENABLED/);\n  await assert.rejects(\n    denied.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n    /disabled/,\n  );\n  const allowed = harness({ hasUI: false, enabled: true });\n  const result = await allowed.execute(\"skim_text\", {\n    text: \"hello\",\n    goal: \"goal\",\n  });\n  assert.equal(result.structuredContent.status, \"complete\");\n  await allowed.command(\"disable\");\n  await assert.rejects(\n    allowed.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n    /disabled/,\n  );\n});\n\ntest(\"missing or rejected credentials block transmission and report unavailability\", async () => {\n  const h = harness({ enabled: true, usable: false });\n  await assert.rejects(\n    h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n    /Jev is unavailable/,\n  );\n  assert.equal(h.requests.length, 0);\n  await h.command(\"status\");\n  assert.match(h.notifications.at(-1)!, /unavailable/);\n  assert.equal(h.constructors(), 0);\n  h.auth(true);\n  await h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" });\n  assert.equal(h.constructors(), 1);\n});\n\ntest(\"a confirmation cannot grant consent to a changed session\", async () => {\n  const h = harness();\n  let resolve!: (value: boolean) => void;\n  h.confirm(\n    () =>\n      new Promise<boolean>((done) => {\n        resolve = done;\n      }),\n  );\n  const enabling = h.command(\"enable\");\n  h.session(\"session-two\");\n  h.events.get(\"session_start\")!({}, h.ctx);\n  resolve(true);\n  await assert.rejects(enabling, /consent changed/);\n  await assert.rejects(\n    h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n    /disabled/,\n  );\n});\n\ntest(\"concurrent confirmations cannot replace the active consent lifetime\", async () => {\n  const h = harness();\n  const pending: ((value: boolean) => void)[] = [];\n  h.confirm(() => new Promise<boolean>((resolve) => pending.push(resolve)));\n  const first = h.command(\"enable\");\n  const second = h.command(\"enable\");\n  pending[0]!(true);\n  await first;\n  pending[1]!(true);\n  await assert.rejects(second, /consent changed/);\n  const result = await h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" });\n  assert.equal(result.structuredContent.status, \"complete\");\n});\n\ntest(\"disable cancels an active batch without returning partial verdicts\", async () => {\n  let entered!: () => void;\n  const ready = new Promise<void>((resolve) => {\n    entered = resolve;\n  });\n  const h = harness({\n    enabled: true,\n    evaluate: async (_requests, config) => {\n      entered();\n      await new Promise<void>((resolve) =>\n        config.signal.addEventListener(\"abort\", () => resolve(), {\n          once: true,\n        }),\n      );\n      return {\n        answers: {},\n        failures: 1,\n        skipped: 1,\n        usage: { input_tokens: 0, output_tokens: 0 },\n      };\n    },\n  });\n  const running = h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" });\n  await ready;\n  const rejected = assert.rejects(\n    running,\n    /cancelled.*Original input retained/,\n  );\n  await h.command(\"disable\");\n  await rejected;\n  const artifacts = readdirSync(h.root);\n  assert.equal(artifacts.length, 1);\n  assert.equal(\n    JSON.parse(\n      readFileSync(join(h.root, artifacts[0]!, \"original.json\"), \"utf8\"),\n    ).text,\n    \"hello\",\n  );\n});\n\ntest(\"unexpected transport failures do not expose exception bodies or submitted secrets\", async () => {\n  const h = harness({\n    enabled: true,\n    evaluate: async () => {\n      throw new Error(\"UPSTREAM_PRIVATE_BODY\");\n    },\n  });\n  await assert.rejects(\n    h.execute(\"skim_text\", { text: \"hello\", goal: \"goal\" }),\n    (error: Error) => {\n      assert.match(error.message, /Original input retained/);\n      assert.ok(!error.message.includes(\"UPSTREAM_PRIVATE_BODY\"));\n      return true;\n    },\n  );\n});\n","numLines":535,"startLine":1,"totalLines":535}},"tool_result_meta":[{"id":"toolu_01Cd41TMSqwJ5DpGvzKTsP1u","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
